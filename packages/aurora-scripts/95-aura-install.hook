# Runs update-aura after kernel, aura and U-Boot changes, and also after a kernel removal,
# so dropping a kernel that needs an older DT ABI generation lets the newest
# kernel's trees through, as Fedora's kernel-install remove does.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/dtbs/*
Target = usr/lib/modules/*/dtb-abi
Target = usr/lib/aurora-boot/*

[Action]
Description = Updating aura Stage 2 image...
When = PostTransaction
Exec = /usr/bin/update-aura
