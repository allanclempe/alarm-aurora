# Aurora's maintenance scripts for Arch Linux ARM.
#
# The ESP helpers (functions.sh), the firmware updater, the mkinitcpio hook,
# update-grub, first-boot and the macsmc battery and SDHCI units started as
# asahi-alarm's asahi-scripts 20261023 (https://github.com/asahi-alarm/asahi-scripts,
# MIT, see LICENSE), with the unit mode fix from its #75. They are kept here
# under Aurora names: the device tree property they read is
# aurora,efi-system-partition and aura's Stage 2 lives under aurora/ on the ESP,
# with the old names read only as transitional fallbacks.
#
# update-aura is Fedora's trial-then-commit Stage 2 updater
# (aurora-silicon/fedora-aurora#193, #207, #232, #251): bootchain.py and test_bootchain.py are
# fedora-aurora's packages/update-aura files, as are the units and the preset;
# bootchain_arch.py only gives them Arch's paths. A kernel update composes
# <stage2>.next, arms aura's one-shot aura-try and keeps the live image until
# aurora-stage2-commit.service accepts the trial boot. 95-aura-install.hook also
# runs on a kernel removal. Each composed Stage 2 goes through aurora-secboot's
# "stage2 hook" when that is installed, which signs it with the owner's Stage 2
# key for an owner-key Stage 1; the stage2-sign-hook marker tells aurora-secboot
# stage1 build so.
pkgname=aurora-scripts
pkgver=20261023
pkgrel=10
pkgdesc='Aurora maintenance scripts: Stage 2 updater, ESP firmware and initramfs hook'
arch=('any')
url='https://github.com/aurora-silicon/alarm-aurora'
license=('MIT')
depends=('bash' 'coreutils' 'dtc' 'gzip' 'python' 'util-linux')
checkdepends=('dtc' 'python')
# aura requires aurora-stage2-ctxr-slot: an aura without the monitor must never
# reach boot.bin through a stock updater, whatever its version. The kernel,
# aura and U-Boot require aurora-stage2-trial, this trial-aware updater.
# LEGACY-ASAHI(2027-02-28): takes over the package of the old name.
provides=('aurora-stage2-ctxr-slot=1' 'aurora-stage2-trial=1' "asahi-scripts=$pkgver")
# aura and U-Boot from before the rename install their images under the old
# directory name, which update-aura no longer reads.
conflicts=('asahi-scripts' 'aura<1.0.0b13.1-2' 'uboot-aurora<2026.07.aurora11-2')
replaces=('asahi-scripts')
source=(
        LICENSE
        functions.sh
        aurora-fwupdate
        update-grub
        first-boot
        first-boot.service
        initcpio-install
        initcpio-hook
        initcpio-install-legacy
        macsmc-battery-charge-control-end-threshold.path
        macsmc-battery-charge-control-end-threshold.service
        93-macsmc-battery-charge-control.rules
        65-autosuspend-override-aurora-sdhci.hwdb
        update-aura
        95-aura-install.hook
        bootchain.py
        bootchain_arch.py
        test_bootchain.py
        test_bootchain_arch.py
        aurora-stage2-commit
        aurora-stage2-commit.service
        aurora-stage2-guard.service
        aurora-stage2-guard.timer
        90-aurora-stage2.preset)
install=aurora-scripts.install
sha256sums=('6a4ce06ab14079af339a8e30570a8dc175ffb8d0b5fb6e2c159b22283450639b'
