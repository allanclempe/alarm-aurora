check() {
  cd "${srcdir}"

  python3 test_bootchain.py
  python3 test_bootchain_arch.py
}

package() {
  cd "${srcdir}"

  install -Dm755 -t "$pkgdir/usr/bin" aurora-fwupdate update-aura update-grub first-boot
  # LEGACY-ASAHI(2027-02-28): the updater's old command name, for scripts written before the rename.
  ln -s update-aura "$pkgdir/usr/bin/update-m1n1"
  install -Dm644 functions.sh "$pkgdir/usr/share/aurora-scripts/functions.sh"
  install -d "$pkgdir/usr/lib/firmware/vendor"
  install -Dm644 initcpio-install "$pkgdir/usr/lib/initcpio/install/aurora"
  install -Dm644 initcpio-hook "$pkgdir/usr/lib/initcpio/hooks/aurora"
  install -Dm644 initcpio-install-legacy "$pkgdir/usr/lib/initcpio/install/asahi"
  install -Dm644 first-boot.service "$pkgdir/usr/lib/systemd/system/first-boot.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s /usr/lib/systemd/system/first-boot.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/first-boot.service"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" \
    macsmc-battery-charge-control-end-threshold.path \
    macsmc-battery-charge-control-end-threshold.service
  install -Dm644 93-macsmc-battery-charge-control.rules \
    "$pkgdir/usr/lib/udev/rules.d/93-macsmc-battery-charge-control.rules"
  install -Dm644 65-autosuspend-override-aurora-sdhci.hwdb \
    "$pkgdir/usr/lib/udev/hwdb.d/65-autosuspend-override-aurora-sdhci.hwdb"
  install -Dm644 95-aura-install.hook "$pkgdir/usr/share/libalpm/hooks/95-aura-install.hook"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 -t "$pkgdir/usr/libexec/aurora" bootchain.py bootchain_arch.py
  install -Dm755 aurora-stage2-commit "$pkgdir/usr/libexec/aurora/aurora-stage2-commit"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" aurora-stage2-commit.service \
    aurora-stage2-guard.service aurora-stage2-guard.timer
  install -Dm644 90-aurora-stage2.preset "$pkgdir/usr/lib/systemd/system-preset/90-aurora-stage2.preset"
  # aurora-secboot stage1 build --enforce looks for this marker before it builds
  # a Stage 1 that refuses unsigned Stage 2s.
  install -Dm644 /dev/null "$pkgdir/usr/share/aurora/stage2-sign-hook"
}
